{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prediction-details.schema.json",
  "$comment": "SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved. SPDX-License-Identifier: Apache-2.0",
  "title": "AISimulate selected prediction details",
  "type": "object",
  "required": [
    "schema_version",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "sections": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "summary": {
          "$ref": "#/$defs/section"
        },
        "memory": {
          "$ref": "#/$defs/section"
        },
        "time": {
          "$ref": "#/$defs/section"
        },
        "source": {
          "$ref": "#/$defs/section"
        },
        "energy": {
          "oneOf": [
            {
              "$ref": "#/$defs/section"
            },
            {
              "type": "object",
              "required": [
                "schema_version",
                "publication_status",
                "scope",
                "phases"
              ],
              "properties": {
                "schema_version": {
                  "const": "1.0"
                },
                "publication_status": {
                  "enum": [
                    "available",
                    "withheld",
                    "unsupported"
                  ]
                },
                "phases": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "name",
                      "operations"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "operations": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "name"
                          ],
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "latency_ms": {
                              "type": "number",
                              "minimum": 0
                            }
                          },
                          "additionalProperties": true
                        }
                      }
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "available",
            "partial",
            "unavailable"
          ]
        },
        "scope": {
          "type": "string"
        },
        "unavailable_reason": {
          "type": "string"
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "operations"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "operations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "latency_ms": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  }
}

+// AIS optional timing for the pinned upstream. The server supplies Linux
+// CLOCK_MONOTONIC; no Rust Instant epoch is compared with a Python timestamp.
+#[derive(Default)]
+struct AisTiming {
+    clock: Option<fn() -> u64>,
+    images: Vec<(u64, u64)>,
+    spans: Vec<serde_json::Value>,
+}
+
+thread_local! {
+    static AIS_TIMING: std::cell::RefCell<Option<AisTiming>> = const { std::cell::RefCell::new(None) };
+}
+
+pub fn ais_begin_timing(clock: Option<fn() -> u64>) {
+    AIS_TIMING.with(|state| {
+        *state.borrow_mut() = Some(AisTiming {
+            clock,
+            ..Default::default()
+        })
+    });
+}
+
+pub fn ais_take_timing() -> (Vec<(u64, u64)>, Vec<serde_json::Value>) {
+    AIS_TIMING.with(|state| {
+        let timing = state.borrow_mut().take().unwrap_or_default();
+        (timing.images, timing.spans)
+    })
+}
+
+fn ais_start() -> Option<u64> {
+    AIS_TIMING.with(|state| {
+        state
+            .borrow()
+            .as_ref()
+            .and_then(|v| v.clock)
+            .map(|clock| clock())
+    })
+}
+
+fn ais_span(
+    op: &str,
+    category: &str,
+    started_ns: Option<u64>,
+    ended_ns: Option<u64>,
+    metadata: impl FnOnce() -> serde_json::Value,
+) {
+    if let (Some(started_ns), Some(ended_ns)) = (started_ns, ended_ns) {
+        AIS_TIMING.with(|state| {
+            if let Some(timing) = state.borrow_mut().as_mut() {
+                timing.spans.push(serde_json::json!({
+                    "event": "boundary_span", "op": op, "category": category,
+                    "started_ns": started_ns, "ended_ns": ended_ns, "metadata": metadata(),
+                }));
+            }
+        });
+    }
+}

index 0000000..5cb2dd2
--- /dev/null
+++ b/rust/sglang-server/src/ais_timing.rs
@@ -0,0 +1,166 @@
+//! AIS diagnostic instrumentation; original addition for the pinned SGLang
+//! timing patch. Disabled unless explicitly requested; no scheduling changes.
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::io::{BufWriter, Write};
+use std::sync::{Mutex, OnceLock};
+
+thread_local! {
+    static ROWS: RefCell<Vec<serde_json::Value>> = const { RefCell::new(Vec::new()) };
+}
+
+pub fn enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| {
+        std::env::var("AIS_VL_BOUNDARY_TRACE").is_ok_and(|v| v == "1")
+            && std::env::var_os("AIS_MM_TIMING_PATH").is_some()
+    })
+}
+
+pub fn legacy_enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var_os("AIS_MM_TIMING_PATH").is_some())
+}
+
+pub fn clock_ns() -> u64 {
+    let mut ts = libc::timespec {
+        tv_sec: 0,
+        tv_nsec: 0,
+    };
+    // CLOCK_MONOTONIC is system-wide on this Linux serving host, matching
+    // time.monotonic_ns() in Python. Never substitute an Instant origin.
+    let rc = unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut ts) };
+    assert_eq!(rc, 0, "CLOCK_MONOTONIC unavailable");
+    ts.tv_sec as u64 * 1_000_000_000 + ts.tv_nsec as u64
+}
+
+pub fn start() -> Option<u64> {
+    enabled().then(clock_ns)
+}
+
+pub fn row(mut row: serde_json::Value, rid: &str) {
+    row["pid"] = std::process::id().into();
+    row["tid"] = (unsafe { libc::syscall(libc::SYS_gettid) } as u64).into();
+    row["clock"] = "CLOCK_MONOTONIC".into();
+    row["rid"] = rid.into();
+    row["rids"] = serde_json::json!([rid]);
+    ROWS.with(|rows| rows.borrow_mut().push(row));
+}
+
+pub fn point(op: &str, rid: &str) {
+    if let Some(ns) = start() {
+        row(
+            serde_json::json!({"event": "boundary_point", "op": op, "category": "scheduler",
+            "time_ns": ns, "started_ns": ns, "ended_ns": ns}),
+            rid,
+        );
+    }
+}
+
+pub fn span(
+    op: &str,
+    category: &str,
+    rid: &str,
+    start: Option<u64>,
+    metadata: impl FnOnce() -> serde_json::Value,
+) {
+    if let Some(started_ns) = start {
+        let ended_ns = clock_ns();
+        row(
+            serde_json::json!({"event": "boundary_span", "op": op, "category": category,
+            "started_ns": started_ns, "ended_ns": ended_ns, "metadata": metadata()}),
+            rid,
+        );
+    }
+}
+
+// One buffered file write per completed worker/intake/drain scope, rather than
+// opening and flushing the file around every image operation. The collector
+// still observes each legacy sample before the result is handed to the TM.
+pub fn flush() {
+    let rows = ROWS.with(|rows| std::mem::take(&mut *rows.borrow_mut()));
+    if rows.is_empty() {
+        return;
+    }
+    static WRITER: OnceLock<Mutex<BufWriter<std::fs::File>>> = OnceLock::new();
+    let writer = WRITER.get_or_init(|| {
+        let path = std::env::var_os("AIS_MM_TIMING_PATH").expect("timing path");
+        let file = std::fs::OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(path)
+            .expect("open AIS timing output");
+        Mutex::new(BufWriter::with_capacity(64 * 1024, file))
+    });
+    let mut writer = writer.lock().unwrap();
+    for row in rows {
+        serde_json::to_writer(&mut *writer, &row).expect("serialize AIS timing");
+        writer.write_all(b"\n").expect("write AIS timing");
+    }
+    writer.flush().expect("flush AIS timing");
+}
+
+pub struct Flush;
+impl Drop for Flush {
+    fn drop(&mut self) {
+        flush();
+    }
+}
+
+// Bytes keep their allocation as the request moves through the in-process
+// channel. Correlate that identity instead of re-parsing/hash-scanning headers.
+fn pending() -> &'static Mutex<HashMap<usize, String>> {
+    static PENDING: OnceLock<Mutex<HashMap<usize, String>>> = OnceLock::new();
+    PENDING.get_or_init(|| Mutex::new(HashMap::new()))
+}
+
+pub fn channel_push(header: &[u8], rid: &str) {
+    if enabled() {
+        pending()
+            .lock()
+            .unwrap()
+            .insert(header.as_ptr() as usize, rid.to_owned());
+        point("rust_channel_push", rid);
+    }
+}
+
+pub fn channel_pop(header: &[u8]) {
+    if enabled() {
+        if let Some(rid) = pending()
+            .lock()
+            .unwrap()
+            .remove(&(header.as_ptr() as usize))
+        {
+            point("rust_channel_pop", &rid);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn monotonic_clock_agrees_across_worker_threads() {
+        let before = clock_ns();
+        let worker = std::thread::spawn(clock_ns).join().unwrap();
+        let after = clock_ns();
+        assert!(before <= worker && worker <= after);
+        assert!(after - before < 5_000_000_000);
+    }
+
+    #[test]
+    fn buffered_rows_preserve_rid_clock_and_native_thread_identity() {
+        row(
+            serde_json::json!({"event": "boundary_point"}),
+            "request-full-nonce",
+        );
+        let rows = ROWS.with(|rows| std::mem::take(&mut *rows.borrow_mut()));
+        assert_eq!(rows.len(), 1);
+        assert_eq!(rows[0]["clock"], "CLOCK_MONOTONIC");
+        assert_eq!(rows[0]["rids"], serde_json::json!(["request-full-nonce"]));
+        assert_eq!(rows[0]["pid"], std::process::id());
+        assert!(rows[0]["tid"].as_u64().unwrap() > 0);
+    }
+}
